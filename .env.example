# --- Model provider keys (only the provider you actually use needs a value) ---
# You don't have to edit these by hand — run `python -m merjack.keys` (or the in-app
# prompt) and it will ask for whatever key your selected models need and save it here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Tier: the product's free (base) vs paid model switch ---
#   free : gpt-oss via OpenRouter (one free key) + manual sourcing. Needs OPENROUTER_API_KEY.
#   paid : Claude direct + live browser sourcing. Needs ANTHROPIC_API_KEY.
MERJACK_TIER=free

# Optional: force live browser sourcing on/off independent of the tier.
# MERJACK_LIVE_SOURCING=false

# Optional per-task model overrides (win over the tier). Format "provider:model";
# use "openrouter:<slug>" for OpenRouter, or a native provider (anthropic/openai/...).
# The scoring model must support tool/function calling + structured output.
# MERJACK_MODEL_SCORING=openrouter:openai/gpt-oss-20b:free
# MERJACK_MODEL_EXPLAIN=openrouter:openai/gpt-oss-120b:free
# MERJACK_MODEL_SOURCING=anthropic:claude-sonnet-4-6

# --- SBA financing defaults (override per deal in the UI) ---
# SBA 7(a) variable rate is roughly prime + ~2.75%. Update as rates move.
MERJACK_SBA_ANNUAL_RATE=0.105
MERJACK_SBA_TERM_YEARS=10
MERJACK_SBA_DOWN_PCT=0.10

# --- Optional: LangSmith tracing for inspecting the graph while developing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=merjack
